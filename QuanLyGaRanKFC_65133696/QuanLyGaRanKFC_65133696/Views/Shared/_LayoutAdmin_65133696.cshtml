<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - KFC Admin System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f3f4f6;
            margin: 0;
            overflow-x: hidden;
        }

         
        .sidebar {
            min-width: 260px;
            max-width: 260px;
            height: 100vh;
            background: #1e1e2d;  
            color: #fff;
            position: fixed;
            top: 0; left: 0;
            transition: all 0.3s;
            z-index: 1000;
            overflow-y: auto;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
        }

         
        .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #E4002B;  
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

         
        .sidebar-menu { padding: 20px 10px; }
        .sidebar-menu ul { list-style: none; padding: 0; }
        .sidebar-menu li { margin-bottom: 8px; }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #a2a3b7;  
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 14px;
            font-weight: 500;
            position: relative;
        }

         
        .sidebar-menu a:hover, .sidebar-menu a.active {
            background: #2b2b40;
            color: #fff;
            padding-left: 20px;  
        }

        .sidebar-menu a.active {
            background: #E4002B;  
            box-shadow: 0 4px 10px rgba(228, 0, 43, 0.4);
        }

        .sidebar-menu i.icon-main {
            width: 30px;
            font-size: 18px;
            text-align: center;
            margin-right: 10px;
        }

         
        .arrow-icon {
            margin-left: auto;  
            font-size: 12px;
            transition: transform 0.3s ease;
        }

         
        a[aria-expanded="true"] .arrow-icon {
            transform: rotate(180deg);
        }

         
        .submenu {
            background: #151521;
            border-radius: 8px;
            margin-top: 5px;
            padding: 5px 0;
        }
        .submenu li a {
            padding-left: 50px;
            font-size: 13px;
        }
        .submenu li a:hover {
            color: #E4002B;
            background: transparent;  
        }

         
        .main-content {
            margin-left: 260px;
            padding: 25px;
            transition: all 0.3s;
        }

         
        .admin-header {
            background: #fff;
            padding: 15px 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .user-profile img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid #E4002B;
            padding: 2px;
        }

    </style>
</head>
<body>

    <nav class="sidebar">
        <div class="sidebar-brand">
            <i class="fa-solid fa-drumstick-bite me-2"></i> KFC MANAGER
        </div>

        <div class="sidebar-menu">
            <ul>
                <li>
                    <a href="@Url.Action("TrangChuAdmin_65133696", "QuanLy_65133696")" class="@(ViewContext.RouteData.Values["Action"].ToString() == "TrangChuAdmin_65133696" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie icon-main"></i> Tổng quan
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyDonHang_65133696", "QuanLy_65133696")" class="@(ViewContext.RouteData.Values["Action"].ToString().Contains("DonHang") ? "active" : "")">
                        <i class="fa-solid fa-receipt icon-main"></i> Quản lý Đơn hàng
                    </a>
                </li>

                @{
                    string currentAction = ViewContext.RouteData.Values["Action"].ToString();
                    bool isProductMenuOpen = currentAction.Contains("LoaiMon") || currentAction.Contains("MonAn") || currentAction.Contains("KhuyenMai");
                }
                <li>
                    <a href="#menuProduct" data-bs-toggle="collapse" aria-expanded="@isProductMenuOpen" class="@(isProductMenuOpen ? "active" : "")">
                        <i class="fa-solid fa-burger icon-main"></i>
                        <span>Món & Khuyến mãi</span>
                        <i class="fa-solid fa-chevron-down arrow-icon"></i>
                    </a>

                    <ul class="collapse list-unstyled submenu @(isProductMenuOpen ? "show" : "")" id="menuProduct">
                        <li>
                            <a href="@Url.Action("QuanLyLoaiMon_65133696", "QuanLy_65133696")" class="@(currentAction.Contains("LoaiMon") ? "text-danger fw-bold" : "")">
                                <i class="fa-solid fa-circle-dot me-2" style="font-size: 8px;"></i> Loại món (Danh mục)
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("QuanLyMonAn_65133696", "QuanLy_65133696")" class="@(currentAction.Contains("MonAn") ? "text-danger fw-bold" : "")">
                                <i class="fa-solid fa-circle-dot me-2" style="font-size: 8px;"></i> Danh sách Món ăn
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("QuanLyKhuyenMai_65133696", "QuanLy_65133696")" class="@(currentAction.Contains("KhuyenMai") ? "text-danger fw-bold" : "")">
                                <i class="fa-solid fa-circle-dot me-2" style="font-size: 8px;"></i> Chương trình KM
                            </a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyKhachHang_65133696", "QuanLy_65133696")" class="@(currentAction.Contains("KhachHang") ? "active" : "")">
                        <i class="fa-solid fa-users icon-main"></i> Khách hàng
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("QuanLyPhanHoi_65133696", "QuanLy_65133696")" class="@(currentAction.Contains("PhanHoi") ? "active" : "")">
                        <i class="fa-solid fa-comments icon-main"></i> Phản hồi & Liên hệ
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("ThongKeDoanhThu_65133696", "QuanLy_65133696")" class="@(currentAction == "ThongKeDoanhThu_65133696" ? "active" : "")">
                        <i class="fa-solid fa-file-invoice icon-main"></i> Báo cáo doanh thu
                    </a>
                </li>

                <li style="margin-top: 40px; border-top: 1px solid #2b2b40; padding-top: 20px;">
                    <a href="@Url.Action("DangXuat_65133696", "KhachHang_65133696")" style="color: #ff6b6b;">
                        <i class="fa-solid fa-right-from-bracket icon-main"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="main-content">
        <div class="admin-header">
            <div>
                <h4 style="margin:0; font-weight:700; color:#333;">@ViewBag.Title</h4>
                <small class="text-muted">@DateTime.Now.ToString("dd/MM/yyyy") - Chúc bạn một ngày làm việc hiệu quả!</small>
            </div>

            <div class="user-profile">
                @{ var admin = Session["NguoiDung_65133696"] as QuanLyGaRanKFC_65133696.Models.Tai_Khoan; }
                <div class="text-end lh-1">
                    <div style="font-weight: 600; color: #333;">@(admin != null ? admin.HoTen : "Administrator")</div>
                    <small style="color: #E4002B; font-size: 12px;">Quản trị viên cấp cao</small>
                </div>
                <img src="https://ui-avatars.com/api/?name=@(admin!=null?admin.HoTen:"Admin")&background=E4002B&color=fff" alt="Admin">
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Kích hoạt mọi tooltip
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
</body>
</html>