@using QuanLyGaRanKFC_65133696.Models
@model Mon_An

@{
    ViewBag.Title = Model.TenMon;
    Layout = "~/Views/Shared/_LayoutKhachHang_65133696.cshtml";
}

@functions {
    public string LayThuMucAnh(string tenLoai)
    {
        if (string.IsNullOrEmpty(tenLoai)) return "MonMoi";
        tenLoai = tenLoai.ToLower();
        if (tenLoai.Contains("combo")) return "Combo";
        if (tenLoai.Contains("gà") || tenLoai.Contains("ga")) return "MonGa";
        if (tenLoai.Contains("burger") || tenLoai.Contains("cơm") || tenLoai.Contains("mì")) return "ComMiBurger";
        if (tenLoai.Contains("giải khát") || tenLoai.Contains("uống")) return "GiaiKhat";
        if (tenLoai.Contains("ưu đãi")) return "UuDai";
        return "MonMoi";
    }
}

<style>
    .detail-container {
        max-width: 1100px;
        margin: 50px auto;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
        display: flex;
        flex-wrap: wrap;
        border: 1px solid #f0f0f0;
    }

    .detail-image-col {
        flex: 1;
        min-width: 350px;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        border-right: 1px solid #f5f5f5;
    }

        .detail-image-col img {
            width: 100%;
            max-width: 450px;
            height: auto;
            object-fit: contain;
            transition: transform 0.3s;
        }

            .detail-image-col img:hover {
                transform: scale(1.05);
            }

    .detail-info-col {
        flex: 1;
        min-width: 350px;
        padding: 50px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .product-title {
        font-size: 32px;
        font-weight: 900;
        color: #333;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .product-category {
        display: inline-block;
        background: #f0f0f0;
        color: #666;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 25px;
        width: fit-content;
    }

    .product-price-large {
        font-size: 36px;
        color: #E4002B;
        font-weight: 900;
        margin-bottom: 30px;
    }

    .quantity-wrapper {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }

    .qty-label {
        font-weight: 700;
        color: #333;
    }

    .qty-box {
        display: flex;
        border: 2px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .btn-qty {
        width: 45px;
        height: 45px;
        border: none;
        background: #fff;
        font-size: 20px;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-qty:hover {
            background: #f8f9fa;
            color: #E4002B;
        }

    .input-qty {
        width: 60px;
        text-align: center;
        border: none;
        border-left: 1px solid #eee;
        border-right: 1px solid #eee;
        font-weight: bold;
        font-size: 18px;
        outline: none;
    }

    .btn-add-cart {
        display: inline-block;
        background: #E4002B;
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 15px 40px;
        border-radius: 40px;
        border: none;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(228, 0, 43, 0.3);
        text-decoration: none;
        text-align: center;
        width: 100%; 
    }

        .btn-add-cart:hover {
            background: #c00020;
            color: #fff;
            transform: translateY(-3px);
        }
</style>

@{
    string tenThuMuc = "MonMoi";
    if (Model.Loai_Mon != null) { tenThuMuc = LayThuMucAnh(Model.Loai_Mon.TenLoai); }
    string fullPath = Model.HinhAnh != null && Model.HinhAnh.Contains("~/Content") ? Model.HinhAnh : "~/Content/imagesKFC_65133696/" + tenThuMuc + "/" + (string.IsNullOrEmpty(Model.HinhAnh) ? tenThuMuc + Model.MaMon + ".jpg" : Model.HinhAnh);
}

<div class="container">
    <div style="margin-top: 30px; margin-left: 20px;">
        <a href="@Url.Action("DanhSachMon_65133696", "KhachHang_65133696")" style="color:#666; font-weight:600; text-decoration:none;">
            <i class="fa-solid fa-arrow-left"></i> Quay lại thực đơn
        </a>
    </div>

    <div class="detail-container">
        <div class="detail-image-col">
            <img src="@Url.Content(fullPath)" alt="@Model.TenMon" onerror="this.src='https://via.placeholder.com/500?text=KFC'" />
        </div>

        <div class="detail-info-col">

            <form action="@Url.Action("ThemVaoGio_65133696", "KhachHang_65133696")" method="get">
                <input type="hidden" name="id" value="@Model.MaMon" />

                <div class="product-category">@(Model.Loai_Mon != null ? Model.Loai_Mon.TenLoai : "KFC")</div>
                <h1 class="product-title">@Model.TenMon</h1>

                <div class="product-description">
                    <p style="color:#555; line-height:1.6;">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Hương vị gà rán truyền thống đậm đà bản sắc KFC, giòn rụm khó cưỡng." : Model.MoTa)
                    </p>
                </div>

                <div class="product-price-large">@String.Format("{0:0,0}", Model.Gia) đ</div>

                @if (Session["NguoiDung_65133696"] != null)
                {
                    <div class="quantity-wrapper">
                        <span class="qty-label">Số lượng:</span>
                        <div class="qty-box">
                            <button type="button" class="btn-qty" onclick="updateQty(-1)">-</button>
                            <input type="text" name="soLuong" id="inputQty" class="input-qty" value="1" readonly>
                            <button type="button" class="btn-qty" onclick="updateQty(1)">+</button>
                        </div>
                    </div>

                    <button type="submit" class="btn-add-cart">
                        <i class="fa-solid fa-cart-plus me-2"></i> THÊM VÀO GIỎ
                    </button>
                }
                else
                {
                    <a href="@Url.Action("DangNhap_65133696", "KhachHang_65133696")" class="btn-add-cart" style="background:#333;">
                        <i class="fa-solid fa-lock me-2"></i> ĐĂNG NHẬP ĐỂ MUA
                    </a>
                }
            </form>
        </div>
    </div>
</div>

<script>
    
    function updateQty(change) {
        var input = document.getElementById('inputQty');
        var currentVal = parseInt(input.value);
        var newVal = currentVal + change;
        if (newVal >= 1) { 
            input.value = newVal;
        }
    }
</script>