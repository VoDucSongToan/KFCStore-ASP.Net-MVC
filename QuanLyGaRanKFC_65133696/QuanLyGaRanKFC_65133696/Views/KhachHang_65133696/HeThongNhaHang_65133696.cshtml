@using QuanLyGaRanKFC_65133696.Models
@model List<Chi_Nhanh>

@{
    ViewBag.Title = "Hệ Thống Nhà Hàng - KFC";
    Layout = "~/Views/Shared/_LayoutKhachHang_65133696.cshtml";
}

<style>
     
    .map-wrapper {
        display: flex;
        height: calc(100vh - 83px);  
        width: 100%;
        overflow: hidden;
    }

     
    .store-sidebar {
        width: 400px;
        background: #fff;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #ddd;
        z-index: 10;
    }

    .search-section {
        padding: 20px;
        border-bottom: 1px solid #eee;
    }

    .search-section h2 {
        color: #E4002B;
        font-weight: 900;
        font-size: 22px;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

    .search-input-wrapper {
        position: relative;
    }

    .search-input-wrapper input {
        width: 100%;
        padding: 12px 40px 12px 15px;
        border-radius: 25px;
        border: 1px solid #ccc;
        outline: none;
    }

    .search-input-wrapper i {
        position: absolute;
        right: 15px;
        top: 13px;
        color: #999;
    }

    .store-list {
        flex: 1;
        overflow-y: auto;
    }

    .store-item {
        padding: 20px;
        border-bottom: 1px solid #f5f5f5;
        cursor: pointer;
        transition: 0.3s;
    }

    .store-item:hover {
        background: #f9f9f9;
    }

    .store-item.active {
        border-left: 5px solid #E4002B;
        background: #fff5f5;
    }

    .store-item h4 {
        font-weight: 800;
        font-size: 15px;
        margin-bottom: 5px;
        color: #222;
        text-transform: uppercase;
    }

    .store-item p {
        font-size: 13px;
        color: #666;
        margin: 0 0 5px 0;
        line-height: 1.4;
    }

     
    .map-display {
        flex: 1;
        background: #eee;
    }

    iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

</style>

<div class="map-wrapper">
    <div class="store-sidebar">
        <div class="search-section">
            <h2>Hệ thống nhà hàng</h2>
            <div class="search-input-wrapper">
                <input type="text" id="storeSearch" placeholder="Tìm kiếm theo địa chỉ..." onkeyup="filterStores()">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
        </div>

        <div class="store-list" id="style-4">
            @if (Model != null && Model.Any())
            {
                int count = 0;
                foreach (var item in Model)
                {
                    <div class="store-item @(count == 0 ? "active" : "")"
                         onclick="updateMap(this, '@item.LinkMap')"
                         data-search="@item.TenCN @item.DiaChi">
                        <h4>@item.TenCN</h4>
                        <p><i class="fa-solid fa-location-dot"></i> @item.DiaChi</p>
                        <p><i class="fa-solid fa-phone"></i> @item.SoDT</p>
                        <p style="color: #28a745; font-weight: 600;"><i class="fa-regular fa-clock"></i> @item.GioMoCua</p>
                    </div>
                    count++;
                }
            }
        </div>
    </div>

    <div class="map-display">
        @{
            var firstStore = Model.FirstOrDefault();
            string initialMap = firstStore != null ? firstStore.LinkMap : "";
        }
        <iframe id="mapFrame" src="@initialMap" allowfullscreen="" loading="lazy"></iframe>
    </div>
</div>

<script>
    // Hàm cập nhật bản đồ khi click vào chi nhánh
    function updateMap(element, link) {
        if (!link || link === "") return;

        // Cập nhật iframe
        document.getElementById('mapFrame').src = link;

        // Đổi trạng thái Active
        var items = document.getElementsByClassName('store-item');
        for (var i = 0; i < items.length; i++) {
            items[i].classList.remove('active');
        }
        element.classList.add('active');
    }

    // Hàm tìm kiếm chi nhánh nhanh
    function filterStores() {
        var input = document.getElementById("storeSearch");
        var filter = input.value.toUpperCase();
        var items = document.getElementsByClassName("store-item");

        for (var i = 0; i < items.length; i++) {
            var txtValue = items[i].getAttribute("data-search");
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                items[i].style.display = "";
            } else {
                items[i].style.display = "none";
            }
        }
    }
</script>