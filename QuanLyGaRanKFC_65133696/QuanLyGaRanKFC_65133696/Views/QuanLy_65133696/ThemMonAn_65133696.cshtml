@using QuanLyGaRanKFC_65133696.Models
@model Mon_An

@{
    ViewBag.Title = "Thêm Món Mới";
    Layout = "~/Views/Shared/_LayoutAdmin_65133696.cshtml";
}

<div class="container-fluid">
    <div class="card shadow border-0" style="max-width: 900px; margin: 0 auto;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0 fw-bold">THÊM MÓN ĂN MỚI</h5>
        </div>
        <div class="card-body p-4">

            @using (Html.BeginForm("ThemMonAn_65133696", "QuanLy_65133696", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="fw-bold">Tên món ăn:</label>
                            <input type="text" name="TenMon" class="form-control" required placeholder="Ví dụ: Combo Gà Rán..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold">Giá bán (VNĐ):</label>
                                <input type="number" name="Gia" class="form-control" required min="1000" step="1000" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold">Danh mục:</label>
                                @Html.DropDownList("MaLoai", null, new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Mô tả chi tiết:</label>
                            <textarea name="MoTa" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <div class="col-md-5 text-center">
                        <label class="fw-bold mb-2">Hình ảnh sản phẩm:</label>
                        <div style="border: 2px dashed #ccc; padding: 10px; border-radius: 10px; margin-bottom: 10px; background: #f9f9f9;">
                            <img id="previewImg" src="https://via.placeholder.com/300x200?text=Chon+Anh"
                                 style="max-width: 100%; height: 200px; object-fit: contain;" />
                        </div>
                        <input type="file" name="fileAnh" class="form-control" required onchange="previewImage(this)" />
                    </div>
                </div>

                <div class="text-center mt-4 border-top pt-3">
                    <a href="@Url.Action("QuanLyMonAn_65133696", "QuanLy_65133696")" class="btn btn-secondary me-2">Quay lại</a>
                    <button type="submit" class="btn btn-danger px-4">LƯU MÓN ĂN</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewImg').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>