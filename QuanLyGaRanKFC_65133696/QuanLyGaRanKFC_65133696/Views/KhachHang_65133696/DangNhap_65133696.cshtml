@{
    ViewBag.Title = "Đăng Nhập Hệ Thống";
    Layout = "~/Views/Shared/_LayoutKhachHang_65133696.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

<style>
     

    .login-page-container {
        background-color: #f0f2f5;  
        min-height: 85vh;  
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
    }

    .login-form-box {
        background-color: #ffffff;  
        width: 100%;
        max-width: 450px;  
        padding: 40px 40px;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);  
        text-align: center;
        border: 1px solid #eaeaea;
    }

    .login-title {
        color: #E4002B;  
        font-weight: 900;
        font-size: 32px;
        text-transform: uppercase;
        margin-bottom: 30px;
        letter-spacing: 1px;
    }

     
    .custom-input-group {
        position: relative;
        margin-bottom: 25px;
        width: 100%;
    }

    .custom-input {
        width: 100%;
        height: 50px;
        background-color: #f7f7f7;
        border: 1px solid #e1e1e1;
        border-radius: 25px;
        padding: 0 20px 0 55px;  
        color: #333;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            background-color: #fff;
            border-color: #E4002B;
            box-shadow: 0 0 0 4px rgba(228, 0, 43, 0.1);
        }

        .custom-input::placeholder {
            color: #999;
        }

     
    .input-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 16px;
        color: #888;
        pointer-events: none;
        transition: 0.3s;
    }

    .custom-input:focus + .input-icon {
        color: #E4002B;
    }

     
    .btn-login-red {
        width: 100%;
        height: 50px;
        background: #E4002B;
        color: white;
        font-weight: 700;
        font-size: 16px;
        text-transform: uppercase;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        margin-top: 10px;
        box-shadow: 0 4px 15px rgba(228, 0, 43, 0.3);
        transition: 0.3s;
    }

        .btn-login-red:hover {
            background: #c00020;
            box-shadow: 0 6px 20px rgba(228, 0, 43, 0.5);
            transform: translateY(-2px);
        }

     
    .options-row {
        text-align: left;
        margin-top: 15px;
        padding-left: 10px;
        color: #666;
        font-size: 14px;
        display: flex;
        align-items: center;
    }

        .options-row input[type="checkbox"] {
            accent-color: #E4002B;
            cursor: pointer;
        }

    .bottom-link {
        margin-top: 30px;
        color: #555;
        font-size: 14px;
    }

        .bottom-link a {
            color: #E4002B;
            font-weight: bold;
            text-decoration: none;
        }

            .bottom-link a:hover {
                text-decoration: underline;
            }

     
    .alert-custom {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 10px;
        font-size: 14px;
        text-align: left;
    }

    .alert-success-custom {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-danger-custom {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="login-page-container">
    <div class="login-form-box">
        <h2 class="login-title">ĐĂNG NHẬP</h2>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert-custom alert-success-custom">
                <i class="fa-solid fa-check-circle"></i> @ViewBag.ThongBao
            </div>
        }
        @if (ViewBag.Loi != null)
        {
            <div class="alert-custom alert-danger-custom">
                <i class="fa-solid fa-circle-exclamation"></i> @ViewBag.Loi
            </div>
        }

        <form action="@Url.Action("DangNhap_65133696", "KhachHang_65133696")" method="post">

            <div class="custom-input-group">
                <input type="text" name="Email" class="custom-input" placeholder="Email đăng nhập..." required />
                <i class="fa-solid fa-envelope input-icon"></i>
            </div>

            <div class="custom-input-group">
                <input type="password" name="MatKhau" id="loginPass" class="custom-input" placeholder="Mật khẩu..." required />
                <i class="fa-solid fa-lock input-icon"></i>
            </div>

            <div class="options-row">
                <input type="checkbox" onclick="toggleLoginPass()" id="chkShowPass" style="margin-right: 8px; width:16px; height:16px;">
                <label for="chkShowPass" style="cursor: pointer;">Hiển thị mật khẩu</label>
            </div>

            <button type="submit" class="btn-login-red">ĐĂNG NHẬP</button>

            <div class="bottom-link">
                Chưa có tài khoản?
                <a href="@Url.Action("DangKy_65133696", "KhachHang_65133696")">Đăng ký ngay</a>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleLoginPass() {
        var x = document.getElementById("loginPass");
        if (x.type === "password") {
            x.type = "text";
        } else {
            x.type = "password";
        }
    }
</script>