@using QuanLyGaRanKFC_65133696.Models
@model Loai_Mon

@{
    ViewBag.Title = "Sửa Danh Mục";
    Layout = "~/Views/Shared/_LayoutAdmin_65133696.cshtml";
}

<div class="container-fluid">
    <div class="card shadow border-0" style="max-width: 500px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0 fw-bold">CẬP NHẬT DANH MỤC</h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.HiddenFor(m => m.MaLoai)
                <div class="mb-3">
                    <label class="fw-bold mb-2">Tên loại món:</label>
                    @Html.TextBoxFor(m => m.TenLoai, new { @class = "form-control", required = "required" })
                </div>
                <div class="text-end">
                    <a href="@Url.Action("QuanLyLoaiMon_65133696", "QuanLy_65133696")" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>