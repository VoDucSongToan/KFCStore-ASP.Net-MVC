@{
    ViewBag.Title = "Tổng Quan Hệ Thống";
    Layout = "~/Views/Shared/_LayoutAdmin_65133696.cshtml";
}

<style>
     
    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-left: 5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

    .stat-content h3 {
        font-size: 28px;
        font-weight: 800;
        margin: 0;
        color: #333;
    }

    .stat-content p {
        margin: 5px 0 0;
        color: #888;
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

     
     
    .card-revenue {
        border-left-color: #28a745;
    }

        .card-revenue .stat-icon {
            background: #e8f5e9;
            color: #28a745;
        }

     
    .card-orders {
        border-left-color: #17a2b8;
    }

        .card-orders .stat-icon {
            background: #e0f7fa;
            color: #17a2b8;
        }

     
    .card-pending {
        border-left-color: #ffc107;
    }

        .card-pending .stat-icon {
            background: #fff3cd;
            color: #ffc107;
            animation: pulse 2s infinite;
        }

     
    .card-users {
        border-left-color: #6f42c1;
    }

        .card-users .stat-icon {
            background: #f3e5f5;
            color: #6f42c1;
        }

     
    .welcome-banner {
        background: linear-gradient(135deg, #E4002B 0%, #ff6b6b 100%);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 5px 20px rgba(228, 0, 43, 0.3);
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }
</style>

<div class="container-fluid">
    <h3 class="mb-4 fw-bold text-secondary">BẢNG ĐIỀU KHIỂN</h3>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="stat-card card-revenue">
                <div class="stat-content">
                    <h3>@string.Format("{0:N0}", ViewBag.TongDoanhThu) đ</h3>
                    <p>Tổng doanh thu</p>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-sack-dollar"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <a href="@Url.Action("QuanLyDonHang_65133696", "QuanLy_65133696")" class="stat-card card-orders">
                <div class="stat-content">
                    <h3>@ViewBag.TongDonHang</h3>
                    <p>Tổng đơn hàng</p>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </a>
        </div>

        <div class="col-md-3 mb-4">
            <a href="@Url.Action("QuanLyDonHang_65133696", "QuanLy_65133696")" class="stat-card card-pending">
                <div class="stat-content">
                    <h3 class="text-warning">@ViewBag.DonChoXacNhan</h3>
                    <p class="text-warning">Chờ xác nhận</p>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>
            </a>
        </div>

        <div class="col-md-3 mb-4">
            <a href="@Url.Action("QuanLyKhachHang_65133696", "QuanLy_65133696")" class="stat-card card-users">
                <div class="stat-content">
                    <h3>@ViewBag.TongKhachHang</h3>
                    <p>Thành viên</p>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-users"></i>
                </div>
            </a>
        </div>
    </div>

    <div class="welcome-banner">
        <div>
            <h2>Xin chào, Quản trị viên!</h2>
            <p class="mb-0 opacity-75">
                Hệ thống đang hoạt động ổn định. Hiện có <strong>@ViewBag.DonChoXacNhan đơn hàng</strong> mới cần bạn xử lý ngay.
            </p>
        </div>
        <div>
            <a href="@Url.Action("QuanLyDonHang_65133696", "QuanLy_65133696")" class="btn btn-light fw-bold text-danger">
                <i class="fa-solid fa-arrow-right"></i> Xử lý ngay
            </a>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div style="background: white; padding: 20px; border-radius: 12px; text-align: center; color: #999;">
                <i class="fa-solid fa-chart-line fa-3x mb-3" style="color:#eee;"></i>
                <p>Biểu đồ doanh thu chi tiết sẽ được cập nhật trong phiên bản tiếp theo...</p>
            </div>
        </div>
    </div>
</div>